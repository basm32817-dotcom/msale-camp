# =============================================================
#  إعدادات المشروع — انسخ هذا الملف باسم  .env  واملأ القيم
#  (cp .env.example .env)
# =============================================================

# منفذ الخادم
PORT=3000

# -------------------------------------------------------------
# رقم واتساب الإدارية الذي سيصل إليه ملفات الـPDF.
# ضع الرقم مع رمز الدولة بدون مسافات أو علامة + مثال: 9665xxxxxxxx
# -------------------------------------------------------------
WHATSAPP_ADMIN_NUMBER=ضع رقم الواتساب هنا

# -------------------------------------------------------------
# ربط حقيقي عبر WhatsApp Cloud API (من Meta Business):
# 1) أنشئ تطبيقًا على https://developers.facebook.com
# 2) أضف منتج WhatsApp وفعّل رقم واتساب أعمال
# 3) انسخ التوكن ومعرّف الرقم من لوحة تحكم Meta
# -------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=ضع_توكن_الوصول_هنا
WHATSAPP_PHONE_NUMBER_ID=ضع_رقم_معرّف_الهاتف_هنا
WHATSAPP_API_VERSION=v21.0
